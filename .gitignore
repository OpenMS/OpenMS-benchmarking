# Benchmark outputs (regenerated by the workflow / local runs)
# NOTE: only the root-level results/ dir is ignored. The per-run result JSONs
# in benchmark/results/{openms,tools} ARE tracked on purpose: they are the
# stored baseline the HTML report compares against (see README.md).
/results/

# Raw per-run smoke outputs inside benchmark/results (regenerated every run;
# only the normalized result JSONs in {openms,tools}/ are kept in git).
benchmark/results/logs/
benchmark/results/meta.txt
benchmark/results/stages.tsv
benchmark/results/summary.txt
benchmark/results/smoke.json
benchmark/results/decoy.fasta
benchmark/results/comet.idXML
benchmark/results/rescored.idXML

