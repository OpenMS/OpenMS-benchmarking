# Keep shell scripts and workflows LF-only: CRLF breaks bash on Linux runners
# and in Git Bash.
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf

# Data fixtures must stay LF as well: CRLF breaks the FASTA parser
# on Linux runners (DecoyDatabase rejects '' in sequences).
*.fasta text eol=lf
*.mzML text eol=lf
